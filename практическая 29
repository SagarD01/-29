#include <iostream>;
#include <Windows.h>
#include<cmath>
using namespace std;

double calc(double num1, double num2, int oper) {
	
	switch (oper) {
	case 1:
		return num1 + num2;
		break;
	case 2:
		return num1 - num2;
		break;
	case 3:
		return num1 * num2;
		break;
	case 4:
		return num1 / num2;
		break;
	case 5:
		return int(num1) % int(num2);
		break;
	case 6:
		return pow(num1, num2);
		break;
	case 7:
		return pow(num1, 1/num2);
		break;
	case 8:
		return pow(num1, 3);
		return pow(num2, 3);
		
		break;
	}

}
double sincosCALC(float num1, int oper) {
	switch (oper) {
	case 9: {
		double angle = num1 * (3.14 / 180);
		return sin(angle);
		break;
	}
	case 10: {
		double angle = num1 * (3.14 / 180);
		return cos(angle);
		break;
	}
	}
}

